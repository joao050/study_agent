# Provedor padrão: gemini, openai, anthropic, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-2.5-flash

# Chaves de API (preencha a do seu provedor de preferência)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Para modelos locais (Ollama)
OLLAMA_API_BASE=http://localhost:11434
